# Copy this file to .env and fill in your own key.
# Get an OpenAI key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Which OpenAI model to use for question generation & feedback
OPENAI_MODEL=gpt-4o-mini

# Whisper model size for local transcription: tiny, base, small, medium, large-v3
# Bigger = more accurate but slower and more RAM/VRAM. "base" or "small" is a good
# starting point on a normal Windows laptop with no GPU.
WHISPER_MODEL_SIZE=base
